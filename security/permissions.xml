<?xml version="1.0" encoding="UTF-8"?>
<!-- SecureNav-NEXUS topic-level ACLs. One <grant> per enclave; render_permissions.py extracts each one.
     Least privilege: only nav2 and the brain may publish /cmd_vel; only the IDS guardian may publish /sys/e_stop. -->
<dds xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:noNamespaceSchemaLocation="http://www.omg.org/spec/DDS-Security/20170801/omg_shared_ca_permissions.xsd">
  <permissions>

    <grant name="nav2">
      <subject_name>CN=nav2,O=SecureNav-NEXUS</subject_name>
      <validity><not_before>2025-01-01T00:00:00</not_before><not_after>2035-01-01T00:00:00</not_after></validity>
      <allow_rule>
        <domains><id>42</id></domains>
        <publish><partitions><partition></partition></partitions><topics>
          <topic>cmd_vel</topic><topic>plan</topic><topic>local_costmap/*</topic><topic>global_costmap/*</topic><topic>rosout</topic><topic>parameter_events</topic>
        </topics></publish>
        <subscribe><topics>
          <topic>odom</topic><topic>scan</topic><topic>perception/*</topic><topic>mission/waypoints</topic><topic>sys/e_stop</topic><topic>tf</topic><topic>tf_static</topic><topic>parameter_events</topic>
        </topics></subscribe>
      </allow_rule>
      <default>DENY</default>
    </grant>

    <grant name="vision">
      <subject_name>CN=vision,O=SecureNav-NEXUS</subject_name>
      <validity><not_before>2025-01-01T00:00:00</not_before><not_after>2035-01-01T00:00:00</not_after></validity>
      <allow_rule>
        <domains><id>42</id></domains>
        <publish><topics>
          <topic>perception/detections</topic><topic>perception/anomaly</topic><topic>perception/depth</topic><topic>rosout</topic><topic>parameter_events</topic>
        </topics></publish>
        <subscribe><topics>
          <topic>camera/color/image_raw</topic><topic>camera/depth/image_raw</topic><topic>lidar/points</topic><topic>parameter_events</topic>
        </topics></subscribe>
      </allow_rule>
      <default>DENY</default>
    </grant>

    <grant name="brain">
      <subject_name>CN=brain,O=SecureNav-NEXUS</subject_name>
      <validity><not_before>2025-01-01T00:00:00</not_before><not_after>2035-01-01T00:00:00</not_after></validity>
      <allow_rule>
        <domains><id>42</id></domains>
        <publish><topics>
          <topic>mission/waypoints</topic><topic>mission/status</topic><topic>agent/actions</topic><topic>fusion/weights</topic><topic>cmd_vel</topic><topic>rosout</topic><topic>parameter_events</topic>
        </topics></publish>
        <subscribe><topics>
          <topic>mission/directive</topic><topic>perception/*</topic><topic>security/alerts</topic><topic>odom</topic><topic>sys/e_stop</topic><topic>parameter_events</topic>
        </topics></subscribe>
      </allow_rule>
      <default>DENY</default>
    </grant>

    <grant name="ids">
      <subject_name>CN=ids,O=SecureNav-NEXUS</subject_name>
      <validity><not_before>2025-01-01T00:00:00</not_before><not_after>2035-01-01T00:00:00</not_after></validity>
      <allow_rule>
        <domains><id>42</id></domains>
        <publish><topics>
          <topic>security/alerts</topic><topic>sys/e_stop</topic><topic>rosout</topic><topic>parameter_events</topic>
        </topics></publish>
        <subscribe><topics>
          <topic>cmd_vel</topic><topic>odom</topic><topic>scan</topic><topic>camera/color/image_raw</topic><topic>perception/*</topic><topic>mission/*</topic><topic>agent/actions</topic><topic>parameter_events</topic>
        </topics></subscribe>
      </allow_rule>
      <default>DENY</default>
    </grant>

    <grant name="hsm">
      <subject_name>CN=hsm,O=SecureNav-NEXUS</subject_name>
      <validity><not_before>2025-01-01T00:00:00</not_before><not_after>2035-01-01T00:00:00</not_after></validity>
      <allow_rule>
        <domains><id>42</id></domains>
        <publish><topics>
          <topic>security/cert_revocations</topic><topic>rosout</topic><topic>parameter_events</topic>
        </topics></publish>
        <subscribe><topics>
          <topic>security/alerts</topic><topic>parameter_events</topic>
        </topics></subscribe>
      </allow_rule>
      <default>DENY</default>
    </grant>

  </permissions>
</dds>
